{
  "name": "watchlist",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently  -n \"REACT,DB\" -c \"\" \" npm run dev:front\" \"npm run dev:back\"",
    "dev:front": "vite",
    "dev:back": "json-server db.json",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.7",
    "json-server": "^1.0.0-beta.15",
    "jsx": "^0.9.89",
    "lucide": "^1.77.0",
    "morphicons": "^2.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
